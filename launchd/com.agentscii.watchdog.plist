<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentscii.watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/octo/agentscii/watchdog.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/octo/agentscii</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd does NOT inherit the user's shell PATH. Without this,
             `claude` (at ~/.local/bin) is unfindable and EVERY Opus gate
             call dies with FileNotFoundError -- which the old code
             reported as "timed out after retry (120s x2)". Found
             2026-09-22 after the error-reporting fix made it visible. -->
        <key>PATH</key>
        <string>/Users/octo/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/octo/agentscii/watchdog.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/octo/agentscii/watchdog.launchd.log</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
