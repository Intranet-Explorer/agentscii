# Reference and training material stays local. Drop any .ans/.ANS into
# workspace/references/study/ and it is usable immediately; only house
# pieces (underscore-prefixed, see the end of this file) are tracked.
workspace/references/study/*.ans
workspace/references/study/*.ANS
workspace/references/study/*.txt
!workspace/references/study/README.txt

# ANSI training corpus (2026-09-17): downloaded 16colo.rs artpacks and their
# parsed .npz cell-grid output are other artists' actual work, same
# rationale as workspace/references/study/ above -- kept locally for
# corpus-building/training use, not ours to publish/redistribute on
# GitHub. Only the fetch/parse SCRIPTS are tracked, not the downloaded
# packs or parsed output.
corpus/data/
corpus/parsed/
corpus/raw/
corpus/*.zip
corpus/validation_report*.json
corpus/validation_report*.txt
corpus/dedupe_report.json
corpus/technique_manifest.jsonl
corpus/holdout_split.json
corpus/*_full.log
corpus/shipped_scoring_report.json
corpus/windows.jsonl
corpus/train_subsample.jsonl
corpus/train_subsample_pre_filter.jsonl.bak
corpus/eval_results*.json
corpus/mlx_train_data/
corpus/lora_adapters/
corpus/lora_adapters_smoke_test/
corpus/archive_run1_nan_corrupted/*.safetensors
corpus/progress_watchdog_samples/
corpus/captions*.json
corpus/*.log
corpus/patch_index.db
corpus/lora_adapters_lr5e6/
corpus/lora_adapters_flatshaded/
corpus/mlx_train_data_flatshaded/

# checkpoint_eval.py renders (.ans/.png per example, regenerated on
